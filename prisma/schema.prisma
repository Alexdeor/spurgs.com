generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Video {
  id        Int   @id @default(autoincrement())
  title     String
  filename  String
  thumbnail String?
  userEmail String
  createdAt DateTime @default(now())
  }

model User {
  id        Int @id @default(autoincrement())
  username  String @unique
  email     String @unique
  password  String
  createdAt DateTime @default(now())
}
